            "same_and_different",
            "more_and_fewer"
          ],
          "primitives": [
            "same-again",
            "some-is-fewer-than-all"
          ]
        },
        {
          "id": "m1.count",
          "form": "One, two, three. Each thing gets the next number. The order never changes.",
