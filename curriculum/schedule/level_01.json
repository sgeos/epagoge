            "number_word_order"
          ],
          "primitives": [
            "things-can-be-counted",
            "counting-order-is-fixed"
          ]
        },
        {
          "id": "m1.logic",
          "form": "If it rains then the ground is wet. All, some, none. It cannot be both so and not so.",
          "introduces": [
            "if_then",
            "all_some_none",
            "not_both"
          ],
          "primitives": [
            "a-claim-can-be-so-or-not"
          ]
        }
      ]
    },
    {
      "domain": "failure_analysis",
      "units": [
