{
  "level": 1,
  "token_budget": {
    "low": 1000000,
    "high": 10000000,
    "basis": "docs/spec/CURRICULUM_LEVELS.md token distribution. Order of magnitude from word counts, not a measurement."
  },
  "notes": "Level one seeds the primitives later content presupposes and never states. Budget share is derived from scheduled concept count rather than from subject weighting, because what must be grounded is not the same question as what the corpus emphasises. Subject weighting arrives at level three, where breadth of topics begins to matter.",
  "covers": [
    "mathematics_and_formal_logic",
    "failure_analysis",
    "directed_physical_interactions",
    "compressed_communication",
    "record_keeping",
    "agentic_operations",
    "accounting",
    "history_and_philosophy_of_science",
    "institutional_interfacing",
    "cybernetic_biological_systems",
    "normative_adjudication"
  ],
  "domains": [
    {
      "domain": "record_keeping",
      "units": [
        {
          "id": "r1.where",
          "form": "It is here, not there. It is over that way.",
          "teaches": [
            "spatial_position",
            "direction"
          ]
        },
        {
          "id": "r1.when",
          "form": "First this, then that. It took a long time.",
          "teaches": [
            "sequence",
            "duration"
          ],
          "primitives": [
            "cause-precedes-effect"
          ]
        },
        {
          "id": "r1.cycle",
          "form": "Day comes, then night, then day again.",
          "teaches": [
            "cycle"
          ],
          "primitives": [
            "same-again"
          ]
        }
      ]
    },
    {
      "domain": "directed_physical_interactions",
      "units": [
        {
          "id": "p1.things",
          "form": "The cup is here. The cup is empty. It is still the same cup.",
          "teaches": [
            "household_object",
            "presence",
            "emptiness"
          ],
          "primitives": [
            "things-persist"
          ]
        },
        {
          "id": "p1.property",
          "form": "This one is red. This one is big. Red is not big.",
          "teaches": [
            "physical_property"
          ],
          "primitives": [
            "same-again"
          ]
        },
        {
          "id": "p1.change",
          "form": "Let go and it falls. Open it and it is open.",
          "teaches": [
            "change",
            "falling",
            "opening_and_shutting"
          ],
          "primitives": [
            "things-change",
            "things-fall",
            "contact-moves-things"
          ]
        },
        {
          "id": "p1.stands_for",
          "form": "The toy car is not a car. It stands for one.",
          "teaches": [
            "toy"
          ],
          "primitives": [
            "marks-stand-for-things",
            "the-sign-is-not-the-thing"
          ]
        },
        {
          "id": "p1.inside",
          "form": "The water is in the cup. Now it is out of the cup.",
          "teaches": [
            "inside_and_outside"
          ],
          "primitives": [
            "things-persist"
          ]
        },
        {
          "id": "p1.motion",
          "form": "It sits still. You push it and it moves.",
          "teaches": [
            "moving_and_still",
            "force"
          ],
          "primitives": [
            "contact-moves-things"
          ]
        },
        {
          "id": "p1.stuff",
          "form": "The cup is made of stone. The stone is round.",
          "teaches": [
            "material",
            "shape"
          ],
          "primitives": [
            "same-again"
          ]
        },
        {
          "id": "p1.liquid",
          "form": "Water takes the shape of the cup. The empty cup is full of air.",
          "teaches": [
            "liquid",
            "air"
          ],
          "primitives": [
            "things-change"
          ]
        },
        {
          "id": "p1.heat",
          "form": "The stove is hot. The water is cold.",
          "teaches": [
            "heat"
          ],
          "primitives": [
            "some-things-harm"
          ]
        },
        {
          "id": "p1.sound",
          "form": "The cup falls and you hear it.",
          "teaches": [
            "sound"
          ],
          "primitives": [
            "things-change"
          ]
        },
        {
          "id": "p1.weather",
          "form": "Rain falls today. The sky was dry before.",
          "teaches": [
            "weather"
          ],
          "primitives": [
            "things-change"
          ]
        }
      ]
    },
    {
      "domain": "mathematics_and_formal_logic",
      "units": [
        {
