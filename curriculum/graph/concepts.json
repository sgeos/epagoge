{
  "domains": [
    {
      "id": "mathematics_and_formal_logic",
      "note": "Quantity, structure, and proof, with propositional and predicate logic. Informal logic and argumentation belong to institutional_interfacing."
    },
    {
      "id": "failure_analysis",
      "note": "How systems fail, how a cause is isolated from a correlate, and how failure is anticipated before it occurs."
    },
    {
      "id": "directed_physical_interactions",
      "note": "How matter behaves and how it is made to behave differently. Undirected phenomena enter as the premises that license an interaction."
    },
    {
      "id": "compressed_communication",
      "note": "Conveying a claim when the whole of it cannot be conveyed. What may be dropped, what must survive, and saying which was which."
    },
    {
      "id": "record_keeping",
      "note": "Measurement, reference frames, unit accounting, provenance, accuracy, precision, confidence, and whether a record is still current."
    },
    {
      "id": "agentic_operations",
      "note": "Goal-directed execution against the world. Procedure, sequencing, and control of work."
    },
    {
      "id": "accounting",
      "note": "Tracking and reconciliation of flows. Conservation expressed as a procedure."
    },
    {
      "id": "history_and_philosophy_of_science",
      "note": "How a claim is justified, and how knowledge actually developed as against how it is justified."
    },
    {
      "id": "institutional_interfacing",
      "note": "Adversarial claim evaluation and the institutional context that makes it necessary. Scope in docs/decisions/INSTITUTIONAL_INTERFACING.md."
    },
    {
      "id": "cybernetic_biological_systems",
      "note": "Living systems as control systems. Regulation, homeostasis, repair, error correction, and adaptation under damage."
    },
    {
      "id": "normative_adjudication",
      "note": "Settling between competing obligations. Neutral on where an obligation originates, because the conflict between sources is the subject."
    }
  ],
