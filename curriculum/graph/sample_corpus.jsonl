{"id": "m_count_1", "level": 1, "concepts": ["correspondence", "counting", "number_word_order", "sequence"], "claim_class": "formal", "content": "One, two, three. Each thing you point at gets the next number.", "provenance": {"source_claim": "primitive:things-can-be-counted"}}
{"id": "m_order_1", "level": 1, "concepts": ["change", "duration", "knowing", "number_word_order"], "claim_class": "empirical", "content": "One, two, three, four. The words come in that order every time. If you skip one or say them out of order, the counting comes out wrong.", "provenance": {"source_claim": "primitive:counting-order-is-fixed"}}
{"id": "m_nat_2", "level": 2, "concepts": ["duration", "natural_number", "number_word_order", "sequence"], "claim_class": "formal", "content": "The counting numbers go on forever. There is no last one.", "provenance": {"source_claim": "peano:infinite"}}
{"id": "m_add_2", "level": 2, "concepts": ["addition", "sequence"], "claim_class": "formal", "content": "Adding is counting on from where you already are.", "provenance": {"source_claim": "peano:add"}, "simplification": {"kind": "superseded_model", "validity_scope": [2, 4], "superseded_by": "m_add_5"}}
{"id": "m_add_5", "level": 5, "concepts": ["addition", "algebraic_structure"], "claim_class": "formal", "content": "Addition is the binary operation defined by recursion on the successor function, with the group structure this induces.", "provenance": {"source_claim": "peano:add"}}
{"id": "f_break_1", "level": 1, "concepts": ["activity", "change", "household_object", "things_break", "toy"], "claim_class": "empirical", "content": "Things wear out. A cup can crack. A toy can stop working.", "provenance": {"source_claim": "primitive:things-break"}}
{"id": "f_cause_1", "level": 1, "concepts": ["cause_and_effect", "change", "falling", "sequence"], "claim_class": "empirical", "content": "When you drop it, it falls. The dropping came first and made the falling happen.", "provenance": {"source_claim": "primitive:cause-precedes-effect"}}
{"id": "f_chain_3", "level": 3, "concepts": ["causal_chain", "cause_and_effect", "direction", "number_word_order", "sequence"], "claim_class": "empirical", "content": "One thing causes another, which causes another. Following the chain backwards is how you find where it began.", "provenance": {"source_claim": "nts:chain"}}
{"id": "f_sys_2", "level": 2, "concepts": ["change", "component_and_system", "failing", "household_object", "number_word_order"], "claim_class": "empirical", "content": "A bicycle is made of parts. If one part fails the whole bicycle may stop.", "provenance": {"source_claim": "obs:system"}}
{"id": "f_mode_4", "level": 4, "concepts": ["cause_and_effect", "component_and_system", "discourse_marker", "failing", "failure_mode", "number_word_order"], "claim_class": "empirical", "content": "A part can fail in more than one way, and each way has different consequences.", "provenance": {"source_claim": "iec:fmea"}}
{"id": "f_root_5", "level": 5, "concepts": ["cause_and_effect", "change", "danger", "direction", "failing", "investigation_practice", "root_cause"], "claim_class": "empirical", "content": "Following a causal chain backwards from a failure reaches a condition whose correction would have prevented it. That condition is the root cause.", "provenance": {"source_claim": "nts:rca"}}
{"id": "f_popper_6", "level": 6, "concepts": ["cause_and_effect", "checking", "claim_under_test", "discourse_marker", "explanation", "number_word_order", "reporting", "root_cause"], "claim_class": "attributed_position", "content": "On Popper's account a root cause is identified by attempting to refute candidate explanations rather than by accumulating support for one.", "provenance": {"position_holder": "Popper", "contested_by": ["Kuhn", "Lakatos"]}}
{"id": "f_sim_6", "level": 6, "concepts": ["change", "claim_under_test", "duration", "failing", "hazard_rate", "investigation_practice", "quantity"], "claim_class": "conditional_result", "content": "Under a constant-hazard assumption the simulated fleet reaches ten percent cumulative failure at 4,200 hours.", "provenance": {"assumptions": ["constant hazard rate", "no common-cause failure", "perfect inspection"], "method": "Monte Carlo, 10^5 trials", "validation_status": "unvalidated against field data"}}
{"id": "f_latent_5", "level": 5, "concepts": ["accident", "cause_and_effect", "change", "component_and_system", "danger", "duration", "emptiness", "failing", "latent_condition", "presence"], "claim_class": "empirical", "content": "Some conditions sit dormant in a system for years, harmless alone, and combine with a trigger to produce a failure. They are present before the accident and are not its trigger.", "provenance": {"source_claim": "reason:latent"}}
{"id": "f_norm_6", "level": 6, "concepts": ["accident_investigation", "activity", "claim_under_test", "danger", "dependence", "discourse_marker", "explanation", "failing", "investigation_practice", "person", "reporting"], "claim_class": "normative", "content": "On the blameless-postmortem position, an investigation that assigns individual fault suppresses the reporting it depends on, and should therefore avoid doing so.", "provenance": {"position_holder": "the blameless postmortem tradition", "contested_by": ["accountability-first practice"]}}
{"id": "m_same_1", "level": 1, "concepts": ["discourse_marker", "household_object", "number_word_order", "physical_property", "same_and_different"], "claim_class": "empirical", "content": "Two red blocks are the same colour. One is big and one is small, so they are not the same size. Things can be alike in one way and different in another.", "provenance": {"source_claim": "primitive:same-again"}}
{"id": "m_corr_1", "level": 1, "concepts": ["being_told", "correspondence", "emptiness", "household_object", "more_and_fewer", "need", "number_word_order", "spatial_position"], "claim_class": "empirical", "content": "Put one cup in front of each chair. If no cup is left over and no chair is empty, there are just as many cups as chairs. You did not need to count to know.", "provenance": {"source_claim": "primitive:things-can-be-counted"}}
{"id": "f_wear_1", "level": 1, "concepts": ["change", "duration", "emptiness", "household_object", "physical_property", "spatial_position", "things_break", "wearing_out"], "claim_class": "empirical", "content": "Shoes you wear every day get thin at the bottom. Nothing broke all at once. Using a thing changes it a little at a time.", "provenance": {"source_claim": "primitive:things-wear"}}
{"id": "f_told_1", "level": 1, "concepts": ["being_told", "danger", "household_object", "person", "sequence"], "claim_class": "empirical", "content": "You did not know the stove was hot until someone told you. Some things you learn by being told, before you ever find out for yourself.", "provenance": {"source_claim": "primitive:danger-must-be-taught"}}
{"id": "f_check_1", "level": 1, "concepts": ["checking", "household_object", "opening_and_shutting", "person"], "claim_class": "empirical", "content": "Someone said the door was shut. You went and looked, and it was open. When what you are told and what you see do not agree, looking again settles it.", "provenance": {"source_claim": "primitive:checking-settles-it"}}
{"id": "f_alive_1", "level": 1, "concepts": ["living_and_not_living", "dying", "household_object"], "claim_class": "empirical", "content": "Living things die. A cup is not living.", "provenance": {"source_claim": "primitive:living-things-die"}}
{"id": "m_sub_2", "level": 2, "concepts": ["subtraction", "addition", "number_word_order"], "claim_class": "formal", "content": "Take away one and you count back by one.", "provenance": {"source_claim": "peano:sub"}}
{"id": "m_mul_3", "level": 3, "concepts": ["multiplication", "addition", "natural_number"], "claim_class": "formal", "content": "Adding the same number again and again.", "provenance": {"source_claim": "peano:mul"}}
{"id": "m_var_3", "level": 3, "concepts": ["variable", "addition"], "claim_class": "formal", "content": "A letter can be any number you have not found yet.", "provenance": {"source_claim": "algebra:variable"}}
{"id": "m_div_4", "level": 4, "concepts": ["division", "multiplication", "subtraction"], "claim_class": "formal", "content": "Take away the same number again and again until nothing is left.", "provenance": {"source_claim": "peano:div"}}
{"id": "m_fun_4", "level": 4, "concepts": ["function", "variable"], "claim_class": "formal", "content": "A way that takes each number to one other number.", "provenance": {"source_claim": "algebra:function"}}
{"id": "m_rate_5", "level": 5, "concepts": ["rate_of_change", "division", "function", "duration", "change"], "claim_class": "formal", "content": "A rate is the size of the changes in one number for each one in the other.", "provenance": {"source_claim": "calculus:difference_quotient"}}
{"id": "p_here_1", "level": 1, "concepts": ["presence", "emptiness", "change"], "claim_class": "empirical", "content": "A thing is here. Now it is not here.", "provenance": {"source_claim": "primitive:things-change"}}
